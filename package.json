{
  "name": "peanut-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter @peanut-admin/reference-admin build && pnpm docs:build",
    "docs:dev": "vitepress docs",
    "docs:build": "vitepress build docs",
    "docs:check": "./scripts/core-docs-governance check && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint frontend packages/web --max-warnings=0",
    "test:unit": "vitest run frontend/tests packages/web",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@peanut-admin/admin": "workspace:0.1.0-alpha.9",
    "@playwright/test": "1.61.1",
    "@redocly/cli": "2.39.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "happy-dom": "20.10.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "6.4.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.39",
    "vue-tsc": "3.3.7"
  }
}
