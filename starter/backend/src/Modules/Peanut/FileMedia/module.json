{
  "schema_version": 1,
  "key": "peanut.file-media",
  "name": "Peanut File And Media",
  "description": "Tenant-private file metadata, upload, download, and archive infrastructure",
  "version": "0.1.0",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-admin/core",
  "web_package": "@peanut-admin/admin/file-media",
  "dependencies": [],
  "backend": {
    "provider": "ExampleHost\\App\\Modules\\Peanut\\FileMedia\\ModuleProvider",
    "migrations": "Database/Migrations",
