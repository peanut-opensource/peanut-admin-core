{
  "schema_version": 1,
  "key": "peanut.reference-codes",
  "name": "Peanut Reference Codes",
  "description": "Reusable Tenant-owned versioned reference-code infrastructure",
  "version": "0.1.0",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-admin/core",
  "web_package": "@peanut-admin/admin/reference-codes",
  "dependencies": [],
  "backend": {
    "provider": "ExampleHost\\App\\Modules\\Peanut\\ReferenceCodes\\ModuleProvider",
    "migrations": "Database/Migrations",
    "menus": "Resources/menus.json",
    "permissions": "Resources/permissions.json",
    "protected_resources": "Resources/protected-resources.json",
    "reference_code_sets": "Resources/reference-code-sets.json"
  },
  "frontend": {
    "entry": "frontend/src/modules/peanut-reference-codes.ts"
  },
  "database": {
    "owned_tables": [
      "pa_reference_code_set",
      "pa_reference_code_entry",
      "pa_reference_code_entry_version"
    ]
  },
  "contracts": {
    "exports": [],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": []
  }
}
