{
  "name": "peanut-admin/internal-starter-backend",
  "description": "Fixed internal ThinkPHP host for Peanut Admin package verification",
  "type": "project",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "path",
      "url": "../packages/php",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "composer/semver": "3.4.4",
    "opis/json-schema": "2.6.0",
    "php": "^8.3",
    "peanut-admin/core": "3.1.1",
    "topthink/framework": "8.1.4",
    "topthink/think-migration": "3.1.1"
  },
  "autoload": {
    "psr-4": {
      "ExampleHost\\App\\modules\\": "src/modules/",
      "PeanutAdmin\\InternalStarter\\": "src/"
    },
    "exclude-from-classmap": [
      "src/modules/peanut/settings/database/migrations/",
      "src/modules/peanut/reference_codes/database/migrations/",
      "src/modules/peanut/file_media/database/migrations/",
      "src/modules/peanut/task_job/database/migrations/",
      "src/modules/peanut/notification_sms/database/migrations/",
      "src/modules/peanut/import_export/database/migrations/",
      "src/modules/peanut/integration_security/database/migrations/"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.24"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
