#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'ERROR: gitleaks 8.30.1 is required by the accepted dependency decision' >&2
  exit 1
fi

version="$(gitleaks version)"
if [[ "$version" != '8.30.1' ]]; then
  echo "ERROR: gitleaks 8.30.1 is required, found $version" >&2
  exit 1
fi

gitleaks git --redact --no-banner --log-level error .

snapshot="$(mktemp -d "${TMPDIR:-/tmp}/peanut-admin-secret-snapshot.XXXXXX")"
trap 'rm -rf "$snapshot"' EXIT
export PEANUT_SECRET_SNAPSHOT="$snapshot"
git ls-files -co --exclude-standard -z | php -r '
$destination = (string) getenv("PEANUT_SECRET_SNAPSHOT");
$paths = explode("\0", stream_get_contents(STDIN));
foreach ($paths as $path) {
    if ($path === "" || !is_file($path)) {
        continue;
    }
    $target = $destination . "/" . $path;
    $directory = dirname($target);
    if (!is_dir($directory) && !mkdir($directory, 0777, true) && !is_dir($directory)) {
        fwrite(STDERR, "ERROR: cannot create secret-scan snapshot directory\n");
        exit(1);
    }
    if (!copy($path, $target)) {
        fwrite(STDERR, "ERROR: cannot copy {$path} into secret-scan snapshot\n");
        exit(1);
    }
}
'
gitleaks dir --redact --no-banner --log-level error "$snapshot"

echo 'Secret history and working-tree scan: OK'
