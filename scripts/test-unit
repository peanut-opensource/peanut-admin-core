  packages/php/file-media/tests/Unit \
  packages/php/kernel/tests/Unit \
  packages/php/data-permission/tests/Unit \
  packages/php/reference-codes/tests/Unit \
  packages/php/settings/tests/Unit \
  packages/php/testing/tests/Unit \
  packages/php/workflow/tests/Unit \
  backend/tests/Architecture \
  backend/tests/Contract \
  backend/tests/Smoke \
  tests/security/SecurityQualificationContractTest.php \
  tests/performance/PerformanceQualificationContractTest.php \
  tests/supply-chain/SupplyChainQualificationContractTest.php
pnpm test:unit
