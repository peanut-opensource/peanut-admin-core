#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "$#" -ne 1 ]]; then
  echo 'Usage: ./scripts/create-internal-starter <empty-target-directory>' >&2
  exit 64
fi

target="$1"
if [[ -e "$target" ]] && [[ ! -d "$target" ]]; then
  echo "ERROR: starter target is not a directory: $target" >&2
  exit 1
fi
if [[ -d "$target" ]] && [[ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
  echo "ERROR: starter target must be empty: $target" >&2
  exit 1
fi

mkdir -p "$target"

copy_starter_template() {
  local tracked_path relative_path source_path destination_path
  local copied=0

  while IFS= read -r -d '' tracked_path; do
    case "$tracked_path" in
      starter/*) ;;
      *)
        echo "ERROR: tracked starter path escaped the template root: $tracked_path" >&2
        exit 1
        ;;
    esac

    relative_path="${tracked_path#starter/}"
    case "/$relative_path/" in
      */../*|*/./*)
        echo "ERROR: tracked starter path is not portable: $tracked_path" >&2
        exit 1
        ;;
    esac

    source_path="$ROOT/$tracked_path"
    if [[ ! -f "$source_path" ]] || [[ -L "$source_path" ]]; then
      echo "ERROR: tracked starter entry is not a regular file: $tracked_path" >&2
      exit 1
    fi

    destination_path="$target/$relative_path"
    mkdir -p "$(dirname "$destination_path")"
    cp -p "$source_path" "$destination_path"
    copied=$((copied + 1))
  done < <(git -C "$ROOT" ls-files -z -- starter)

  if [[ "$copied" -eq 0 ]]; then
    echo 'ERROR: no tracked starter template files were found' >&2
    exit 1
  fi
}

copy_starter_template

copy_runtime_directory() {
  local source="$1"
  local destination="$2"

  mkdir -p "$destination"
  cp -R "$source/src" "$destination/src"
  for directory in database resources; do
    if [[ -d "$source/$directory" ]]; then
      cp -R "$source/$directory" "$destination/$directory"
    fi
  done
}

mkdir -p "$target/packages/php" "$target/packages/web"
cp "$ROOT/packages/php/composer.json" "$target/packages/php/composer.json"
cp "$ROOT/packages/php/LICENSE" "$target/packages/php/LICENSE"
cp "$ROOT/packages/web/package.json" "$target/packages/web/package.json"
cp "$ROOT/packages/web/LICENSE" "$target/packages/web/LICENSE"

for package in \
  kernel data-permission testing settings reference-codes file-media task-job \
  notification-sms import-export ops-console integration-security; do
  copy_runtime_directory "$ROOT/packages/php/$package" "$target/packages/php/$package"
done

for package in \
  admin-core admin-shell testing settings reference-codes file-media task-job \
  notification-sms import-export ops-console integration-security; do
  copy_runtime_directory "$ROOT/packages/web/$package" "$target/packages/web/$package"
done

echo "Internal starter created at: $target"
