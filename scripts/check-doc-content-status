#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$manifestPath = $root . '/docs/content-status.json';
$allowedStatuses = ['canonical', 'draft', 'superseded', 'generated'];
$errors = [];

try {
    $manifest = json_decode(
        (string) file_get_contents($manifestPath),
        true,
        512,
        JSON_THROW_ON_ERROR
    );
} catch (Throwable $error) {
    fwrite(STDERR, "docs/content-status.json: {$error->getMessage()}\n");
    exit(1);
}

if (!is_array($manifest) || ($manifest['schema_version'] ?? null) !== 1) {
    $errors[] = 'docs/content-status.json: schema_version must equal 1';
}

$documents = $manifest['documents'] ?? null;
if (!is_array($documents)) {
    $errors[] = 'docs/content-status.json: documents must be an array';
    $documents = [];
}

$registered = [];
foreach ($documents as $index => $document) {
    $label = "docs/content-status.json documents[{$index}]";
    if (!is_array($document)) {
        $errors[] = "{$label}: entry must be an object";
        continue;
    }

    foreach (['path', 'title', 'status', 'owner', 'replacement'] as $field) {
        if (!array_key_exists($field, $document)) {
            $errors[] = "{$label}: missing {$field}";
        }
    }

    $path = $document['path'] ?? null;
    if (!is_string($path) || $path === '' || !str_starts_with($path, 'docs/')) {
        $errors[] = "{$label}: path must be a non-empty docs/ path";
        continue;
    }

    if (isset($registered[$path])) {
        $errors[] = "{$path}: duplicate registration";
        continue;
    }
    $registered[$path] = $document;

    foreach (['title', 'owner'] as $field) {
        if (!is_string($document[$field] ?? null) || trim($document[$field]) === '') {
            $errors[] = "{$path}: {$field} must be a non-empty string";
        }
    }

    $status = $document['status'] ?? null;
    if (!is_string($status) || !in_array($status, $allowedStatuses, true)) {
        $errors[] = "{$path}: invalid status";
    }

    $replacement = $document['replacement'] ?? null;
    if ($status === 'superseded' && (!is_string($replacement) || trim($replacement) === '')) {
        $errors[] = "{$path}: superseded documents require a replacement path or none";
    }
    if ($status !== 'superseded' && $replacement !== null) {
        $errors[] = "{$path}: replacement must be null unless status is superseded";
    }

    if (!is_file($root . '/' . $path)) {
        $errors[] = "{$path}: registered file does not exist";
    }
}

$actual = [];
$iterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($root . '/docs', FilesystemIterator::SKIP_DOTS)
);
foreach ($iterator as $file) {
    if (!$file->isFile() || strtolower($file->getExtension()) !== 'md') {
        continue;
    }
    $path = str_replace('\\', '/', substr($file->getPathname(), strlen($root) + 1));
    $actual[$path] = true;
    if (!isset($registered[$path])) {
        $errors[] = "{$path}: Markdown document is not registered";
    }
}

foreach (array_keys($registered) as $path) {
    if (!isset($actual[$path])) {
        $errors[] = "{$path}: registration does not point to a Markdown document";
    }
}

if ($errors !== []) {
    foreach ($errors as $error) {
        fwrite(STDERR, "ERROR: {$error}\n");
    }
    exit(1);
}

fwrite(STDOUT, 'Documentation status: OK (' . count($actual) . " documents)\n");
