#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

mapping="$(php ./scripts/module-key example.work-item)"
php -r '
$mapping = json_decode(stream_get_contents(STDIN), true, 512, JSON_THROW_ON_ERROR);
$expected = [
    "key" => "example.work-item",
    "backend_path" => "backend/app/Modules/Example/WorkItem/",
    "backend_namespace" => "PeanutAdmin\\App\\Modules\\Example\\WorkItem\\",
    "frontend_path" => "frontend/src/modules/example-work-item/",
];
if ($mapping !== $expected) {
    fwrite(STDERR, "ERROR: module key conversion drifted from G-04\n");
    exit(1);
}
' <<< "$mapping"

./scripts/check-module-manifests

if rg -n "from ['\"]@peanut-admin/admin/(?:[^'\"]+/)*(src|internal)/" frontend packages/web; then
  echo 'ERROR: web host or package uses a private deep import' >&2
  exit 1
fi

node --input-type=module <<'NODE'
import fs from 'node:fs'
import path from 'node:path'
import ts from 'typescript'

const packages = new Map([
  ['@peanut-admin/admin/core', 'packages/web/admin-core'],
  ['@peanut-admin/admin/shell', 'packages/web/admin-shell'],
  ['@peanut-admin/admin/settings', 'packages/web/settings'],
  ['@peanut-admin/admin/reference-codes', 'packages/web/reference-codes'],
  ['@peanut-admin/admin/file-media', 'packages/web/file-media'],
  ['@peanut-admin/admin/task-job', 'packages/web/task-job'],
  ['@peanut-admin/admin/notification-sms', 'packages/web/notification-sms'],
  ['@peanut-admin/admin/import-export', 'packages/web/import-export'],
  ['@peanut-admin/admin/ops-console', 'packages/web/ops-console'],
  ['@peanut-admin/admin/integration-security', 'packages/web/integration-security'],
  ['@peanut-admin/admin/testing', 'packages/web/testing'],
])
const allowedDependencies = new Map([
  ['@peanut-admin/admin/core', new Set()],
  ['@peanut-admin/admin/shell', new Set(['@peanut-admin/admin/core'])],
  ['@peanut-admin/admin/settings', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/reference-codes', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/file-media', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/task-job', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/notification-sms', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/import-export', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/ops-console', new Set(['@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/integration-security', new Set(['@peanut-admin/admin/core', '@peanut-admin/admin/shell'])],
  ['@peanut-admin/admin/testing', new Set(['@peanut-admin/admin/core'])],
])
const errors = []
const edges = new Map()

const sourceFiles = directory => fs.readdirSync(directory, { withFileTypes: true }).flatMap(entry => {
  const candidate = path.join(directory, entry.name)
  if (entry.isDirectory()) return entry.name === 'generated' ? [] : sourceFiles(candidate)
  return entry.isFile() && candidate.endsWith('.ts') && !candidate.endsWith('.d.ts') ? [candidate] : []
})

const resolveRelative = (file, specifier) => {
  const base = path.resolve(path.dirname(file), specifier)
  const candidates = specifier.endsWith('.vue')
    ? [base]
    : [`${base}.ts`, `${base}.d.ts`, path.join(base, 'index.ts')]
  return candidates.find(candidate => fs.existsSync(candidate) && fs.statSync(candidate).isFile()) ?? null
}

for (const [packageName, packageRoot] of packages) {
  const root = path.resolve(packageRoot)
  for (const file of sourceFiles(path.join(packageRoot, 'src'))) {
    const absoluteFile = path.resolve(file)
    const source = ts.createSourceFile(file, fs.readFileSync(file, 'utf8'), ts.ScriptTarget.Latest, true)
    for (const statement of source.statements) {
      if (!ts.isImportDeclaration(statement) && !ts.isExportDeclaration(statement)) continue
      if (statement.moduleSpecifier === undefined || !ts.isStringLiteral(statement.moduleSpecifier)) continue
      const specifier = statement.moduleSpecifier.text
      if (specifier.startsWith('@peanut-admin/')) {
        if (!packages.has(specifier)) {
          errors.push(`${file}: private or unknown Peanut Admin import ${specifier}`)
          continue
        }
        if (specifier === packageName || !allowedDependencies.get(packageName)?.has(specifier)) {
          errors.push(`${file}: forbidden package dependency ${packageName} -> ${specifier}`)
        }
        continue
      }
      if (!specifier.startsWith('.')) continue
      const target = resolveRelative(file, specifier)
      if (target === null || !target.startsWith(`${root}${path.sep}`)) {
        errors.push(`${file}: unresolved or cross-package relative import ${specifier}`)
        continue
      }
      const targets = edges.get(absoluteFile) ?? []
      targets.push(target)
      edges.set(absoluteFile, targets)
    }
  }
}

const active = new Set()
const visited = new Set()
const visit = (file, stack) => {
  if (active.has(file)) {
    errors.push(`web source dependency cycle: ${[...stack, file].join(' -> ')}`)
    return
  }
  if (visited.has(file)) return
  active.add(file)
  for (const target of edges.get(file) ?? []) visit(target, [...stack, file])
  active.delete(file)
  visited.add(file)
}
for (const file of edges.keys()) visit(file, [])

if (errors.length > 0) {
  for (const error of errors) console.error(`ERROR: ${error}`)
  process.exit(1)
}
NODE

if rg -n '(localStorage|sessionStorage)' packages/web/admin-core/src; then
  echo 'ERROR: admin-core must not persist tokens, contexts, permissions, modules, or target state' >&2
  exit 1
fi

if rg -n '/packages/(php|web)/' backend/app frontend/src; then
  echo 'ERROR: host source references a package filesystem path' >&2
  exit 1
fi

if rg -ni 'adminer|mailhog|minio|rabbitmq|queue-ui' compose.yaml docker; then
  echo 'ERROR: compose contains a service outside the P0-A04 boundary' >&2
  exit 1
fi

if [[ "${PEANUT_RUNTIME_STAGE:-skeleton}" == "skeleton" ]]; then
  if find backend packages/php -type f \( -path '*/database/migrations/*' -o -path '*/controller/*' \) -print -quit | rg -q .; then
    echo 'ERROR: P0-A04 cannot contain migrations or controllers' >&2
    exit 1
  fi
fi

if rg -n 'DCS|Finance Manager|BusinessSpace|PermissionDomain|MemberIdentity|DataScope' \
  backend frontend packages docker compose.yaml; then
  echo 'ERROR: product-specific or superseded architecture content entered runtime paths' >&2
  exit 1
fi

php vendor/bin/phpunit backend/tests/Architecture
php vendor/bin/deptrac analyse --no-progress --fail-on-uncovered --cache-file=.cache/deptrac.cache

echo 'Architecture boundaries: OK'
